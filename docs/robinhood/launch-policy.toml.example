# Robinhood Chain LAUNCH POLICY
#
# THIS IS A FRAGMENT, NOT A CONFIG FILE.
# It holds one section and none of the sections a bridge config must have
# ([solana], [goldcoin], [reserve], [operators], [service]), so the config
# parser refuses it and every tool that takes `--config` refuses it with
# it. Do NOT pass this path to `scripts/chain-policy.sh --config` or to
# any `glc-admin chain-policy-*` command: copy the section below into the
# config the daemon actually loads, or — better, because it validates the
# numbers and keeps a backup — set the same values with
# `scripts/chain-policy.sh --config /etc/glc-bridge/config.toml`.
# `glc-admin chain-policy-check-config --config <this file>` will read the
# policy stated here back to you without writing anything.
#
# The approved commercial terms for the Goldcoin <-> Robinhood routes:
# the fee rate and the transfer ceilings. Stating them does NOT enable a
# route, start an indexer, or let this process broadcast anything — those
# are `[robinhood].*_enabled`, `[robinhood.indexer]` and
# `[robinhood.settlement]`, and every one of them is a separate decision.
#
# UNITS
# Every amount is a canonical 8-decimal atomic unit — the unit every
# ledger figure in this service uses. 1 GLC = 100_000_000.
# These are NOT the token's native 18-decimal units; the conversion is
# made once, in `robinhood::policy`, and checked for exactness there.
#
# SOLANA IS UNAFFECTED
# `chain_policy::POLICY_GOVERNED_CHAINS` lists which chains a policy may
# name and it holds Robinhood alone, so nothing in this section can
# change the Goldcoin <-> Solana fee (compiled-in BRIDGE_FEE_BPS) or the
# Solana limits (read from the on-chain program account).

[robinhood.policy]

# 6.00%. Must be a rate `amount_conversion::HISTORICAL_FEE_BPS` knows:
# the rate is snapshotted onto every request and re-checked against that
# list at settlement, so a rate accepted here but absent there would
# price a request that could never settle.
fee_bps = 600

# The two per-transfer limits are SEPARATE (docs/40-destination-bound-
# admission.md, "SOURCE TRANSFER LIMIT vs DESTINATION PAYOUT CAP"):
#
# INBOUND — 20,000 GLC: the largest single DEPOSIT into the contract, the
# user-facing source ceiling on RhnToGlc/RhnToSol (the service's own
# `min_transfer::SOURCE_MAXIMUM_ROBINHOOD_CANONICAL` is the same figure).
# The contract enforces it as `inboundMax` (= 20000000000000000000000 at
# 18dp), and preflight FAILS if the chain holds something else.
inbound_per_transfer_limit = 2000000000000

# OUTBOUND — the largest single PAYOUT out of the contract: destination
# settlement capacity for GlcToRhn/SolToRhn, enforced as `outboundMax`.
# NOT a user limit. Under the elastic bridge rate a 50,000 GLC source
# transfer pays out 50,000 × rate × 0.97 GLC on Robinhood Chain, and the
# admission guard keeps a 25 % buffer, so size it as
#   outbound ≥ 50,000 × R × 0.97 / 0.75   for the rate ceiling R you plan for
# (R = 25 → 1,616,667 GLC; R = 30 → 1,940,000; R = 40 → 2,586,667).
# The figure below is the LEGACY symmetric value and is far too small for
# elastic payouts; it is kept only so this fragment still states the
# pre-2026-09-21 policy. `rolling_daily_limit` / 2 must be at least this.
outbound_per_transfer_limit = 2000000000000

# The legacy single `per_transfer_limit = N` key is still accepted and
# means "N for both directions"; it cannot be combined with the two keys
# above.

# 10,000,000 GLC — the STRICT 24-hour ceiling: the most that may move in
# any 86,400-second span.
#
# THE ON-CHAIN VALUE IS HALF OF THIS. `GlcRobinhoodBridge`'s rolling
# window is a FIXED BUCKET that resets wholesale, so 2x the configured
# limit can move within one 86,400s span (its `_consumeWindow` docs prove
# the worst case is exactly 2x and is reachable). To make the worst case
# equal this policy:
#
#   inboundRollingLimit  = outboundRollingLimit
#                        = 500000000000000 canonical
#                        = 5000000000000000000000000 at 18dp
#                        = 5,000,000 GLC
#
# Configuring 10,000,000 GLC on chain would silently double the real
# ceiling to 20,000,000 GLC / 24h. `robinhood::policy` derives the
# on-chain figure from this one and preflight FAILS on any disagreement,
# in either direction.
rolling_daily_limit = 1000000000000000
